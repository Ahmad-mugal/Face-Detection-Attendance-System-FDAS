# Development/demo setup example. Replace this value outside source control.
FDAS_SECRET_KEY=replace-with-a-secure-secret

# Backend-authoritative normal-attendance workflow. FAST_MULTI_FACE is the
# default and skips liveness. Set SECURE_SINGLE_FACE and restart the backend to
# restore the retained MOVE_CLOSER + three-query/2-of-3 workflow.
FDAS_ATTENDANCE_MODE=FAST_MULTI_FACE

# Optional operator approval-email delivery. Leave blank to keep email disabled.
FDAS_SMTP_HOST=smtp.gmail.com
FDAS_SMTP_PORT=587
FDAS_SMTP_USERNAME=
FDAS_SMTP_PASSWORD=
FDAS_SMTP_FROM_EMAIL=
FDAS_SMTP_FROM_NAME=FDAS Administration
FDAS_SMTP_USE_TLS=true

# Trusted frontend origin used to build short-lived password-reset links.
# Do not derive reset links from the incoming Host header.
FDAS_FRONTEND_BASE_URL=http://127.0.0.1:5173
