# Development/demo setup example. Replace this value outside source control.
FDAS_SECRET_KEY=replace-with-a-secure-secret

# Optional operator approval-email delivery. Leave blank to keep email disabled.
FDAS_SMTP_HOST=smtp.gmail.com
FDAS_SMTP_PORT=587
FDAS_SMTP_USERNAME=
FDAS_SMTP_PASSWORD=
FDAS_SMTP_FROM_EMAIL=
FDAS_SMTP_FROM_NAME=FDAS
FDAS_SMTP_USE_TLS=true
